{
  "name": "openclaw-railway",
  "version": "2.0.0",
  "private": true,
  "description": "OpenClaw on Railway — one-click deploy, powered by @chrysb/alphaclaw",
  "scripts": {
    "dev": "docker compose up --build",
    "dev:stop": "docker compose down",
    "dev:clean": "docker compose down -v",
    "dev:logs": "docker compose logs -f",

    "dev:restart": "docker compose restart",
    "dev:shell": "docker compose exec openclaw bash",
    "dev:seed": "bash scripts/seed.sh",
    "dev:fresh": "npm run dev:seed && docker compose up --build",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@chrysb/alphaclaw": "github:iamsteveng/alphaclaw#524f6f3e321bca2ffedd2d67af3a5f3edf7fa47a"
  },
  "engines": {
    "node": ">=22.14.0"
  }
}
